{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-system.local/schemas/scenarios.schema.json",
  "title": "Scenario practice entry",
  "type": "object",
  "required": ["id", "module", "slug", "title", "scenes"],
  "properties": {
    "id": { "type": "string", "pattern": "^sc-" },
    "module": { "const": "scenarios" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "title_en": { "type": "string" },
    "date": { "type": "string" },
    "platform": { "type": "string" },
    "source_url": { "type": "string" },
    "external_html": {
      "type": "string",
      "description": "Link back to language_paraphrase Pages card when audio/images stay there"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title_cn", "sentences"],
        "properties": {
          "id": { "type": "string" },
          "title_cn": { "type": "string" },
          "title_en": { "type": "string" },
          "time": { "type": "string" },
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["zh", "en"],
              "properties": {
                "zh": { "type": "string" },
                "en": { "type": "string" },
                "note": { "type": "string" },
                "audio": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "paraphrase": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "en"],
              "properties": {
                "label": { "type": "string" },
                "en": { "type": "string" },
                "chunks": { "type": "array", "items": { "type": "string" } },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["module", "id"],
                    "properties": {
                      "module": { "enum": ["function", "phrases", "entity"] },
                      "id": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "practice": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zh", "en"],
        "properties": {
          "zh": { "type": "string" },
          "en": { "type": "string" },
          "audio": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
